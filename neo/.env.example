# Boş buraxsan avtomatik ./neo_leads.db (SQLite) istifadə olunur — lokal test üçün.
# Production-da Postgres-ə yönəlt:
# DATABASE_URL=postgresql+psycopg2://neo:neo@localhost:5432/neo_leads
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
# Lead skorlama modeli (defolt: gpt-4o-mini)
AI_MODEL=gpt-4o-mini
# LinkedIn (Apify actor harvestapi/linkedin-post-search) — yoxdursa LinkedIn scraper-i ötürülür
APIFY_TOKEN=
# Admin panel giriş sessiyasını imzalayan gizli açar (uzun təsadüfi mətn).
# Boşdursa hər server restartında hamı çıxış edir. Yaratmaq: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Kontakt toplama (app/contacts.py) ---
# Validasiyaya düşən lead-lərin şirkət saytından email/telefon oxunur (run başına ≤15 sayt). off — söndür.
CONTACT_CRAWL=on

# --- Bizim şirkət: email imzası və LinkedIn şərhi (app/outreach) ---
COMPANY_NAME=
COMPANY_PHONE=
# Çox sətirli imza üçün \n yaz
COMPANY_SIGNATURE=

# --- Email göndərmə: Google Workspace SMTP (app/outreach/mail.py) ---
# SMTP_PASSWORD = Google hesabında "App password" (2 addımlı doğrulama açıq olmalıdır), adi şifrə yox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=
# Məktub və şərh modeli (boşdursa AI_MODEL_V2, sonra gpt-4.1-mini)
AI_EMAIL_MODEL=

# --- LinkedIn avtomatik şərh: Unipile (app/outreach/linkedin_comment.py) ---
# on — LinkedIn alıcı postu təsdiqlənəndə qısa şərh yazılır. Gündəlik limit hesabı qorumaq üçündür.
LINKEDIN_AUTOCOMMENT=off
LINKEDIN_COMMENT_DAILY_CAP=10
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
