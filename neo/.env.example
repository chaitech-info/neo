# Boş buraxsan avtomatik ./neo_leads.db (SQLite) istifadə olunur — lokal test üçün.
# Production-da Postgres-ə yönəlt:
# DATABASE_URL=postgresql+psycopg2://neo:neo@localhost:5432/neo_leads
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
# Lead skorlama modeli (defolt: gpt-4o-mini)
AI_MODEL=gpt-4o-mini
# LinkedIn (Apify actor harvestapi/linkedin-post-search) — yoxdursa LinkedIn scraper-i ötürülür
APIFY_TOKEN=
# Admin panel giriş sessiyasını imzalayan gizli açar (uzun təsadüfi mətn).
# Boşdursa hər server restartında hamı çıxış edir. Yaratmaq: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Qiymət təklifi agenti (Alətlər → Qiymət təklifi). Açarlar yalnız serverdə qalır, brauzerə getmir.
OFFER_AGENT_URL=https://askarhuseynli96--offer-agent-api.us-east.modal.run
# Təklif yaratmaq və oxumaq üçün
OFFER_AGENT_KEY=
# Yalnız paketləri dəyişmək üçün (Alətlər → Paketlər, admin)
OFFER_AGENT_ADMIN_KEY=
